{
  // No "$schema" key: wrangler is run via npx here, so there's no local
  // node_modules for an editor to resolve it against.
  "name": "vox-cinema-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // Logs for cron firings — without this, a failed dispatch is invisible unless
  // you happen to be running `wrangler tail`.
  "observability": { "enabled": true },

  // Every minute: answers Telegram fast; the regular check still runs every 10th minute.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    "GITHUB_REPO": "OMAR6972/vox_cinema",
    "GITHUB_REF": "main"
  }

  // Secrets, not vars: `wrangler secret put GITHUB_TOKEN` and `wrangler secret put TELEGRAM_BOT_TOKEN`.
}
